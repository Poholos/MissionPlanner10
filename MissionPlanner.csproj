<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <StartupObject>MissionPlanner.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppConfig>Porting/net10.app.config</AppConfig>
    <ApplicationIcon>Assets/appicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RootNamespace>MissionPlanner</RootNamespace>

    <!-- The old native WinForms files remain in Git until their manifest rows close. During the
         transition compile only the source-blob-verified Avalonia import and explicit native
         backend files; Porting/NATIVE_SURFACE.tsv keeps every exclusion visible. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsAvaloniaPortProject>true</IsAvaloniaPortProject>
    <IsMissionPlannerApplication>true</IsMissionPlannerApplication>

    <Product>Mission Planner</Product>
    <Company>Mission Planner contributors</Company>
    <Authors>Michael Oborne; Mission Planner contributors</Authors>
    <Description>Cross-platform Mission Planner ground control station for ArduPilot.</Description>
    <Copyright>Copyright © Mission Planner contributors. GPLv3.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Rouniy/MissionPlanner</RepositoryUrl>

    <MissionPlannerVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/Properties/AssemblyInfo.cs'))</MissionPlannerVersionFile>
    <MissionPlannerVersionFileExists>$([System.IO.File]::Exists('$(MissionPlannerVersionFile)'))</MissionPlannerVersionFileExists>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == '' And '$(MissionPlannerVersionFileExists)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MissionPlannerVersionFile)')), 'AssemblyFileVersion\(&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;\)').Groups[1].Value)</MissionPlannerUpstreamVersion>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == ''">0.0.0</MissionPlannerUpstreamVersion>
    <MissionPlannerBuildDate Condition="'$(MissionPlannerBuildDate)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd'))</MissionPlannerBuildDate>
    <Version>$(MissionPlannerUpstreamVersion)</Version>
    <AssemblyVersion>$(MissionPlannerUpstreamVersion).0</AssemblyVersion>
    <FileVersion>$(MissionPlannerUpstreamVersion).0</FileVersion>
    <InformationalVersion>$(MissionPlannerUpstreamVersion)+$(MissionPlannerBuildDate)</InformationalVersion>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishAot Condition="'$(EnableNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <Target Name="ValidateMissionPlannerVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MissionPlannerVersionFileExists)' != 'True'"
           Text="Native Mission Planner Properties/AssemblyInfo.cs is missing." />
    <Error Condition="'$(MissionPlannerUpstreamVersion)' == '0.0.0'"
           Text="Could not read AssemblyFileVersion x.y.z from $(MissionPlannerVersionFile)." />
  </Target>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <Import Project="Porting/ImportedApplicationItems.props" />

  <ItemGroup>
    <Compile Include="Plugin/LegacyCompatibility/MainV2Compatibility.cs" />
    <Compile Include="Plugin/LegacyCompatibility/PluginCompatibility.cs" />
    <Compile Include="Radio/Uploader.cs" />
    <Compile Include="Radio/IHex.cs" />
    <Compile Include="Grid/GridData.cs" />
    <Compile Include="Services/CubeServiceBulletin.cs" />
    <Compile Include="Services/DataFlashLogAnonymizer.cs" />
    <Compile Include="Services/LegacyFirmwareUploader.cs" />
    <Compile Include="Services/LocalizationService.cs" />
    <Compile Include="Services/LocalKmlServer.cs" />
    <Compile Include="Services/MavlinkSerialControlPort.cs" />
    <Compile Include="Services/OsdTuningSlotService.cs" />
    <Compile Include="Services/PythonScriptHost.cs" />
    <Compile Include="Services/SikRadioFirmwareService.cs" />
    <Compile Include="Services/SikRadioSettingsService.cs" />
    <Compile Include="Services/SystemAwakeService.cs" />
    <Compile Include="Views/DroneCanFieldGraphWindow.cs" />
    <Compile Include="Views/DroneCanSubscriberWindow.cs" />
    <Compile Include="Views/OsdTuningSlotsWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.config" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Mapsui.Avalonia" />
    <PackageReference Include="Mapsui.Tiling" />
    <PackageReference Include="Mapsui.Nts" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Projektanker.Icons.Avalonia" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="HidSharp" />
    <PackageReference Include="Linux.Bluetooth" />
    <PackageReference Include="Tmds.DBus" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="MoonSharp" />
    <PackageReference Include="IronPython" />
    <PackageReference Include="IronPython.StdLib" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <PropertyGroup>
    <MacVlcRid Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or
                              '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</MacVlcRid>
    <MacVlcRid Condition="'$(MacVlcRid)' == '' And
                              $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkPortableRuntimeIdentifier)</MacVlcRid>
    <MacVlcRuntimeDir Condition="'$(MacVlcRid)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)vlc/$(MacVlcRid)'))</MacVlcRuntimeDir>
    <SimpleBleMacRid Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or
                                    '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</SimpleBleMacRid>
    <SimpleBleMacRid Condition="'$(SimpleBleMacRid)' == '' And
                                    $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkPortableRuntimeIdentifier)</SimpleBleMacRid>
    <SimpleBleMacNativeDir Condition="'$(SimpleBleMacRid)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)simpleble/$(SimpleBleMacRid)'))</SimpleBleMacNativeDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SimpleBleMacRid)' != ''">
    <Content Include="$(SimpleBleMacNativeDir)/libsimpleble-c.dylib" Link="libsimpleble-c.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(SimpleBleMacNativeDir)/libsimpleble.0.dylib" Link="libsimpleble.0.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
    <ProjectReference Include="ExtLibs/Arduino/Arduino.csproj" />
    <ProjectReference Include="ExtLibs/alglibnet/alglibnet.csproj" />
    <ProjectReference Include="ExtLibs/DroneCAN/DroneCAN.csproj" />
    <ProjectReference Include="Plugin/PortableApi/MissionPlanner.PluginApi.csproj">
      <Aliases>PortablePluginContract</Aliases>
    </ProjectReference>
    <ProjectReference Include="ExtLibs/px4uploader/px4uploader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="COPYING.txt" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="COPYING.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="LICENSES/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ParameterMetaDataBackup.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="mavcmd.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ParameterFactMetaData.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="APMotorLayout.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="camerasBuiltin.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="checklistDefault.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="airports.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="block_plane_0.dae">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="graphs/*.xml" Link="graphs/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlanner.Tests" />
  </ItemGroup>

  <Target Name="FetchMacVlc"
          BeforeTargets="PrepareForBuild"
          Condition="'$(MacVlcRid)' != ''">
    <Error Condition="'$(MacVlcRid)' != 'osx-x64' And
                      '$(MacVlcRid)' != 'osx-arm64'"
           Text="Unsupported macOS VLC runtime identifier: $(MacVlcRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/build/vlc/fetch-macos.sh&quot; &quot;$(MacVlcRid)&quot; &quot;$(MacVlcRuntimeDir)&quot;" />
  </Target>

  <!-- Preserve VLC's original lib/plugins/share layout in output and the final .app bundle. -->
  <Target Name="CollectMacVlcRuntime"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="FetchMacVlc"
          Condition="'$(MacVlcRid)' != ''">
    <ItemGroup>
      <_MacVlcLib Include="$(MacVlcRuntimeDir)/lib/**/*" />
      <_MacVlcPlugins Include="$(MacVlcRuntimeDir)/plugins/**/*" />
      <_MacVlcLua Include="$(MacVlcRuntimeDir)/share/lua/**/*" />
      <_MacVlcHrtfs Include="$(MacVlcRuntimeDir)/share/hrtfs/**/*" />

      <Content Include="@(_MacVlcLib)">
        <Link>lib/%(_MacVlcLib.RecursiveDir)%(_MacVlcLib.Filename)%(_MacVlcLib.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcPlugins)">
        <Link>plugins/%(_MacVlcPlugins.RecursiveDir)%(_MacVlcPlugins.Filename)%(_MacVlcPlugins.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcLua)">
        <Link>share/lua/%(_MacVlcLua.RecursiveDir)%(_MacVlcLua.Filename)%(_MacVlcLua.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcHrtfs)">
        <Link>share/hrtfs/%(_MacVlcHrtfs.RecursiveDir)%(_MacVlcHrtfs.Filename)%(_MacVlcHrtfs.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="FetchMacSimpleBle"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SimpleBleMacRid)' != ''">
    <Error Condition="'$(SimpleBleMacRid)' != 'osx-x64' And
                      '$(SimpleBleMacRid)' != 'osx-arm64'"
           Text="Unsupported macOS SimpleBLE runtime identifier: $(SimpleBleMacRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/build/simpleble/fetch-macos.sh&quot; &quot;$(SimpleBleMacRid)&quot; &quot;$(SimpleBleMacNativeDir)&quot;" />
  </Target>

  <Target Name="RemoveWindowsNativeBinariesFromNonWindowsPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-arm64' Or
                     ('$(RuntimeIdentifier)' == '' And
                      !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libusb-1.0.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble-c.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble.dll'" />
    </ItemGroup>
  </Target>
</Project>
