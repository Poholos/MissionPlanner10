<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <StartupObject>MissionPlanner.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppConfig>Porting/net10.app.config</AppConfig>
    <ApplicationIcon>Assets/appicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RootNamespace>MissionPlanner</RootNamespace>

    <!-- The old native WinForms files remain in Git until their manifest rows close. During the
         transition compile only the source-blob-verified Avalonia import and explicit native
         backend files; Porting/NATIVE_SURFACE.tsv keeps every exclusion visible. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsAvaloniaPortProject>true</IsAvaloniaPortProject>
    <IsMissionPlannerApplication>true</IsMissionPlannerApplication>

    <Product>Mission Planner</Product>
    <Company>Mission Planner contributors</Company>
    <Authors>Michael Oborne; Mission Planner contributors</Authors>
    <Description>Cross-platform Mission Planner ground control station for ArduPilot.</Description>
    <Copyright>Copyright © Mission Planner contributors. GPLv3.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Rouniy/MissionPlanner</RepositoryUrl>

    <MissionPlannerVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/Properties/AssemblyInfo.cs'))</MissionPlannerVersionFile>
    <MissionPlannerVersionFileExists>$([System.IO.File]::Exists('$(MissionPlannerVersionFile)'))</MissionPlannerVersionFileExists>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == '' And '$(MissionPlannerVersionFileExists)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MissionPlannerVersionFile)')), 'AssemblyFileVersion\(&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;\)').Groups[1].Value)</MissionPlannerUpstreamVersion>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == ''">0.0.0</MissionPlannerUpstreamVersion>
    <MissionPlannerBuildDate Condition="'$(MissionPlannerBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</MissionPlannerBuildDate>
    <Version>$(MissionPlannerUpstreamVersion)</Version>
    <AssemblyVersion>$(MissionPlannerUpstreamVersion).0</AssemblyVersion>
    <FileVersion>$(MissionPlannerUpstreamVersion).0</FileVersion>
    <InformationalVersion>$(MissionPlannerUpstreamVersion)+$(MissionPlannerBuildDate)</InformationalVersion>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishAot Condition="'$(EnableNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <Target Name="ValidateMissionPlannerVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MissionPlannerVersionFileExists)' != 'True'"
           Text="Native Mission Planner Properties/AssemblyInfo.cs is missing." />
    <Error Condition="'$(MissionPlannerUpstreamVersion)' == '0.0.0'"
           Text="Could not read AssemblyFileVersion x.y.z from $(MissionPlannerVersionFile)." />
  </Target>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <Import Project="Porting/ImportedApplicationItems.props" />

  <ItemGroup>
    <Compile Include="Plugin/LegacyCompatibility/MainV2Compatibility.cs" />
    <Compile Include="Plugin/LegacyCompatibility/PluginCompatibility.cs" />
    <Compile Include="Radio/Uploader.cs" />
    <Compile Include="Radio/IHex.cs" />
    <Compile Include="Grid/GridData.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.config" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Mapsui.Avalonia" />
    <PackageReference Include="Mapsui.Tiling" />
    <PackageReference Include="Mapsui.Nts" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Projektanker.Icons.Avalonia" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="HidSharp" />
    <PackageReference Include="Linux.Bluetooth" />
    <PackageReference Include="Tmds.DBus" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="MoonSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
    <ProjectReference Include="ExtLibs/alglibnet/alglibnet.csproj" />
    <ProjectReference Include="ExtLibs/DroneCAN/DroneCAN.csproj" />
    <ProjectReference Include="Plugin/PortableApi/MissionPlanner.PluginApi.csproj">
      <Aliases>PortablePluginContract</Aliases>
    </ProjectReference>
    <ProjectReference Include="ExtLibs/px4uploader/px4uploader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="COPYING.txt" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ParameterMetaDataBackup.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="mavcmd.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ParameterFactMetaData.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="APMotorLayout.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="camerasBuiltin.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="checklistDefault.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="airports.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="block_plane_0.dae">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="graphs/*.xml" Link="graphs/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlanner.Tests" />
  </ItemGroup>

  <Target Name="RemoveWindowsNativeBinariesFromNonWindowsPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-arm64' Or
                     ('$(RuntimeIdentifier)' == '' And
                      !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libusb-1.0.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble-c.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble.dll'" />
    </ItemGroup>
  </Target>
</Project>
