<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native source compiled directly as the portable firmware-uploader library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsAvaloniaPortProject>true</IsAvaloniaPortProject>
    <RootNamespace>px4uploader</RootNamespace>
    <AssemblyName>MissionPlanner.Px4Uploader</AssemblyName>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS8032;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="Properties/AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="DotNetZip.NetStandard" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Comms/MissionPlanner.Comms.csproj" />
    <ProjectReference Include="../Interfaces/Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="validcertificates.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
