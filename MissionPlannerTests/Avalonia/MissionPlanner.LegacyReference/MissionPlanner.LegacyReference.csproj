<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RootNamespace>MissionPlanner</RootNamespace>
    <AssemblyVersion>1.3.9999.0</AssemblyVersion>
    <FileVersion>1.3.83.0</FileVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0067</NoWarn>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <!-- ArduPilot's net472 dependency graph otherwise resolves the vulnerable 4.3.0 package.
         The fixture remains binary-compatible while forcing the patched assembly version. -->
    <PackageReference Include="System.Text.RegularExpressions" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
  </ItemGroup>
</Project>
