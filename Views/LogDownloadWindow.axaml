<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:MissionPlanner.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="520"
  d:DesignHeight="420"
  x:Class="MissionPlanner.Views.LogDownloadWindow"
  x:DataType="vm:LogDownloadViewModel"
  Background="{DynamicResource MpControlBg}"
  Width="540"
  Height="440"
  MinWidth="420"
  MinHeight="320"
  WindowStartupLocation="CenterOwner"
  Title="Download Logs (MAVLink)"
>
  <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto">
    <!-- WrapPanel, not StackPanel: six items need ~830px in one row, and a
         horizontal StackPanel silently paints the tail past the window edge -->
    <WrapPanel Grid.Row="0" Orientation="Horizontal">
      <Button Content="Refresh List" Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
      <Button Content="Download Selected" Command="{Binding DownloadCommand}"
              IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
      <Button Content="Download All…" Command="{Binding DownloadAllCommand}"
              IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
      <CheckBox Content="Create KML" IsChecked="{Binding CreateKmlAfterDownload}"
                VerticalAlignment="Center" Margin="0,0,8,8" />
      <Button Content="Erase All…" Command="{Binding EraseAllCommand}"
              IsEnabled="{Binding !IsBusy}" Foreground="#FF7777" Margin="0,0,8,8" />
      <Button Content="Cancel" Command="{Binding CancelDownloadCommand}"
              IsEnabled="{Binding IsBusy}" Margin="0,0,8,8" />
    </WrapPanel>

    <Border Grid.Row="1" BorderBrush="#666" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}"
                IsReadOnly="True" GridLinesVisibility="Horizontal"
                AutoGenerateColumns="False" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
          <DataGridTextColumn Header="Date" Binding="{Binding TimeText}" Width="2*" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <ProgressBar Grid.Row="2" Margin="0,8,0,0" Minimum="0" Maximum="100"
                 Value="{Binding Progress}" Height="16" />

    <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="#BBB" Text="{Binding Status}"
               TextWrapping="Wrap" />
  </Grid>
</Window>
