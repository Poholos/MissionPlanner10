<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MissionPlannerAvalonia.PluginApi</AssemblyName>
    <RootNamespace>MissionPlanner.Plugin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Description>Portable cross-platform plugin contract for Mission Planner.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlanner" />
    <InternalsVisibleTo Include="MissionPlanner.Tests" />
  </ItemGroup>
</Project>
